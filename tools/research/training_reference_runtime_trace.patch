diff --git a/Descent3/Mission.cpp b/Descent3/Mission.cpp
--- a/Descent3/Mission.cpp
+++ b/Descent3/Mission.cpp
@@ -677,3 +677,4 @@
 #include "hud.h"
 #include "localization.h"
+#include "gamepath.h"
 #include "levelgoal.h"
@@ -1286,5 +1287,48 @@ bool LoadMissionLevel(int level) {
     LoadLevelProgress(LOAD_PROGRESS_DONE, 0);
     return false;
   }
+
+  if (FindArg("-revivalroomtrace")) {
+    int used_rooms = 0;
+    int portal_records = 0;
+    int used_objects = 0;
+
+    for (int room_index = 0; room_index <= Highest_room_index; ++room_index) {
+      room &loaded_room = Rooms[room_index];
+      if (!loaded_room.used)
+        continue;
+
+      ++used_rooms;
+      portal_records += loaded_room.num_portals;
+      LOG_INFO.printf("REVIVAL_ROOM room=%d name=%s faces=%d portals=%d object_head=%d", room_index,
+                      loaded_room.name ? loaded_room.name : "", loaded_room.num_faces, loaded_room.num_portals,
+                      loaded_room.objects);
+
+      for (int portal_index = 0; portal_index < loaded_room.num_portals; ++portal_index) {
+        const portal &loaded_portal = loaded_room.portals[portal_index];
+        LOG_INFO.printf("REVIVAL_PORTAL room=%d portal=%d face=%d croom=%d cportal=%d flags=%d", room_index,
+                        portal_index, loaded_portal.portal_face, loaded_portal.croom, loaded_portal.cportal,
+                        loaded_portal.flags);
+      }
+    }
+
+    for (int object_index = 0; object_index <= Highest_object_index; ++object_index) {
+      const object &loaded_object = Objects[object_index];
+      if (loaded_object.type == OBJ_NONE)
+        continue;
+
+      ++used_objects;
+      LOG_INFO.printf("REVIVAL_OBJECT object=%d type=%d runtime_id=%d room=%d name=%s", object_index,
+                      loaded_object.type, loaded_object.id, loaded_object.roomnum,
+                      loaded_object.name ? loaded_object.name : "");
+    }
+
+    LOG_INFO.printf(
+        "REVIVAL_LEVEL_SUMMARY highest_room=%d used_rooms=%d portal_records=%d highest_object=%d used_objects=%d "
+        "terrain_cells=%d paths=%d goals=%d",
+        Highest_room_index, used_rooms, portal_records, Highest_object_index, used_objects,
+        TERRAIN_WIDTH * TERRAIN_DEPTH, Num_game_paths, Level_goals.GetNumGoals());
+    std::exit(EXIT_SUCCESS);
+  }
   // Test to see if levels are valid
   bool boa = true, terrain = true;
